# ── Version control ─────────────────────────────────────────────────────────
.git/
.gitignore

# ── Python bytecode ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Build / dist artefacts ───────────────────────────────────────────────────
build/
dist/
*.egg-info/

# ── IDE & editor configs ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Secrets / local config ───────────────────────────────────────────────────
.env
.env.*
secrets/

# ── Test & CI artefacts ──────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Docker files themselves (avoid inception) ────────────────────────────────
Dockerfile*
docker-compose*.yml
.dockerignore

# ── Documentation (not needed at runtime) ────────────────────────────────────
README.md
ARCHITECTURE.md
docs/

# ── Test files (avoid test textures and rooms photos) ─────────────────────────
__tests__/

# ── Model files (downloaded in Stage 1 of the multi-stage Dockerfile) ──────────
# All .pt checkpoints are fetched from Meta's CDN by the downloader stage and
# copied into the final image via COPY --from=downloader.  Excluding them here
# keeps the build context small and avoids redundant file transfers.
sam2/models/*.pt