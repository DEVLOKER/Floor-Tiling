# ── Version control ─────────────────────────────────────────────────────────
.git/
.gitignore
.github/

# ── Python bytecode ──────────────────────────────────────────────────────────
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Build / dist artefacts ───────────────────────────────────────────────────
**/build/
**/dist/
*.egg-info/

# ── IDE & editor configs ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Local config ───────────────────────────────────────────────────
.env
.env.*

# ── Test & CI artefacts ──────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Docker files themselves (avoid inception) ────────────────────────────────
**/Dockerfile*
**/docker-compose*.yml
.dockerignore

# ── Shell scripts (only used on host, not inside the image) ─────────────────
*.sh
*.bat
*.ps1

# ── Documentation (not needed at runtime) ────────────────────────────────────
README.md
docs/

# ── Test files (not needed inside the image) ────────────────────────────────
__tests__/

# ── Local model checkpoints ──────────────────────────────────────────────────
# Weights are ignored by default (download mode keeps the build context lean).
# The negation re-includes model.safetensors so MODEL_SOURCE=local / offline
# builds can bundle the weights present on disk.
client/mask2former/models/*.bin
client/mask2former/models/*.safetensors
!client/mask2former/models/model.safetensors
client/depth/models/*.bin
client/depth/models/*.safetensors
!client/depth/models/model.safetensors
client/oneformer/models/*.bin
client/oneformer/models/*.safetensors
!client/oneformer/models/model.safetensors

# ── Other files to ignore ───────────────────────────────────────────────────────
*.log
*.pem
*.lic
*.spec
SignTools/