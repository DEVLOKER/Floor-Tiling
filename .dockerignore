# ── Version control ─────────────────────────────────────────────────────────
.git/
.gitignore
.github/

# ── Python bytecode ──────────────────────────────────────────────────────────
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Build / dist artefacts ───────────────────────────────────────────────────
**/build/
**/dist/
*.egg-info/

# ── IDE & editor configs ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Local config ───────────────────────────────────────────────────
.env
.env.*

# ── Test & CI artefacts ──────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Docker files themselves (avoid inception) ────────────────────────────────
**/Dockerfile*
**/docker-compose*.yml
.dockerignore

# ── Shell scripts (only used on host, not inside the image) ─────────────────
*.sh
*.bat
*.ps1

# ── Documentation (not needed at runtime) ────────────────────────────────────
README.md
docs/

# ── Test files (not needed inside the image) ────────────────────────────────
__tests__/

# ── Local model checkpoints ──────────────────────────────────────────────────
# The whole local cache is excluded: the image rebuilds it via
# scripts/prefetch_models.py (WITH_MODELS=true) or downloads it at runtime into a
# mounted volume (WITH_MODELS=false). Keeping it out makes the build context tiny.
client/models/

# ── Other files to ignore ───────────────────────────────────────────────────────
*.log
*.pem
*.lic
*.spec
SignTools/