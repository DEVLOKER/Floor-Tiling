# ── Version control ─────────────────────────────────────────────────────────
.git/
.gitignore
.github/

# ── Python bytecode ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Build / dist artefacts ───────────────────────────────────────────────────
build/
dist/
*.egg-info/

# ── IDE & editor configs ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Secrets / local config ───────────────────────────────────────────────────
.env
.env.*
.env.example
secrets/

# ── Test & CI artefacts ──────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Docker files themselves (avoid inception) ────────────────────────────────
Dockerfile*
docker-compose*.yml
.dockerignore

# ── Shell scripts (only used on host, not inside the image) ─────────────────
*.sh
*.bat
*.ps1

# ── Documentation (not needed at runtime) ────────────────────────────────────
README.md
ARCHITECTURE.md
docs/

# ── Test files (not needed inside the image) ────────────────────────────────
__tests__/

# ── SAM2 non-runtime files ───────────────────────────────────────────────────
# CUDA kernel sources (CPU-only build, never compiled inside the image)
sam2/csrc/
# Benchmark script — development tool only
sam2/benchmark.py

; # ── Local model checkpoints (builder stage fetches fresh ones from Meta CDN)
; #    Excluding avoids copying large .pt files into the build context.
; #    The Dockerfile downloader stage downloads them directly.
; sam2/models/*.pt

# ── Model files (keep only the tiny one for a smaller image) ───────────────────
sam2/models/*.pt
!sam2/models/sam2.1_hiera_tiny.pt


# NOTE: sam2/models/*.pt ARE intentionally included so the image is
# self-contained. If you want a smaller base image, add the line:
#   sam2/models/*.pt
# and volume-mount the models directory at runtime (see docker-compose.yml).