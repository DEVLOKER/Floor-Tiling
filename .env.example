# Floor Tile Visualizer — environment variables
# Copy to .env and customise before running `docker compose up`
# (docker-compose reads .env automatically)

# Host port to expose the app on (default: 8000)
APP_PORT=8000

# Compute device: "cpu" or "cuda" (requires GPU + nvidia-container-toolkit)
APP_DEVICE=cpu

# Log level: debug | info | warning | error
APP_LOG_LEVEL=info
