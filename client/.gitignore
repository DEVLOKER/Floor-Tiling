# ── Python (client) ───────────────────────────────────────────────────────────

# Bytecode / compiled
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
# Cython-generated C sources (emitted next to the compiled modules)
src/floor_tiling/**/*.c
shared/**/*.c

# Build / packaging
build/
dist/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv

# ML model weights (large — auto-downloaded at runtime into models/<name>/).
# Configs/tokenizers stay tracked; only the heavy weights are ignored.
models/**/*.bin
models/**/*.safetensors
models/**/*.pt
models/**/*.pth
models/**/*.onnx

# Cache
.cache/
*.cache

# Testing
.pytest_cache/
.coverage
htmlcov/
