# ── Python (client) ───────────────────────────────────────────────────────────

# Bytecode / compiled
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
# Cython-generated C sources (emitted next to the compiled modules)
src/floor_tiling/**/*.c
shared/**/*.c

# Build / packaging
build/
dist/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv

# ML models — auto-downloaded at runtime into models/<name>/<variant>/.
# Fully LOCAL and never committed: this way switching DETECTION_PROFILE reuses
# already-downloaded variants (each in its own subdir), and switching git
# branches never resets a model config or triggers a re-download. Only the
# .gitkeep placeholders are tracked so the directory structure exists.
models/**
!models/**/
!models/**/.gitkeep

# Cache
.cache/
*.cache

# Testing
.pytest_cache/
.coverage
htmlcov/
